
plugin.tx_nsallsliders_owlcarousel {
	view {
		# cat=plugin.tx_nsallsliders_owlcarousel/file; type=string; label=Path to template root (FE)
		templateRootPath = EXT:ns_all_sliders/Resources/Private/Templates/
		# cat=plugin.tx_nsallsliders_owlcarousel/file; type=string; label=Path to template partials (FE)
		partialRootPath = EXT:ns_all_sliders/Resources/Private/Partials/
		# cat=plugin.tx_nsallsliders_owlcarousel/file; type=string; label=Path to template layouts (FE)
		layoutRootPath = EXT:ns_all_sliders/Resources/Private/Layouts/
	}

	persistence {
		# cat=plugin.tx_nsallsliders_owlcarousel//01; type=string; label=Default storage PID
		storagePid =
	}
	settings {

		# cat=plugin.tx_nsallsliders_owlcarousel//02; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.addjquery
		jQuery = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//03; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.navigation
		Connavigation = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//04; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.autoPlay
		ConAutoPlay = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//06; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.items
		Conitems = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//07; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.lazyLoad
		ConlazyLoad = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//08; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.mouseDrag
		ConmouseDrag = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//09; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.touchDrag
		ContouchDrag = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//10; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.margin
		Conmargin = 0
		# cat=plugin.tx_nsallsliders_owlcarousel//11; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.loop
		Conloop = 
		# cat=plugin.tx_nsallsliders_owlcarousel//13; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.pullDrag
		ConpullDrag = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//14; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.freeDrag
		ConfreeDrag = 
		# cat=plugin.tx_nsallsliders_owlcarousel//15; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.stagePadding
		ConstagePadding = 0
		# cat=plugin.tx_nsallsliders_owlcarousel//16; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.merge
		Conmerge = 
		# cat=plugin.tx_nsallsliders_owlcarousel//17; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.mergeFit
		ConmergeFit = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//18; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.autoWidth
		ConautoWidth = 
		# cat=plugin.tx_nsallsliders_owlcarousel//19; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.startPosition
		ConstartPosition = 0
		# cat=plugin.tx_nsallsliders_owlcarousel//20; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.URLhashListener
		ConURLhashListener = 
		# cat=plugin.tx_nsallsliders_owlcarousel//21; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.rewind
		Conrewind = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//22; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.navElement
		ConnavElement = div
		# cat=plugin.tx_nsallsliders_owlcarousel//23; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.slideBy
		ConslideBy = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//24; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.slideTransition
		ConslideTransition = 
		# cat=plugin.tx_nsallsliders_owlcarousel//25; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dots
		Condots = 1
		# cat=plugin.tx_nsallsliders_owlcarousel//26; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dotsEach
		CondotsEach = 
		# cat=plugin.tx_nsallsliders_owlcarousel//27; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dotsData
		CondotsData= 
		# cat=plugin.tx_nsallsliders_owlcarousel//28; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.lazyLoadEager
		ConlazyLoadEager = 0
		# cat=plugin.tx_nsallsliders_owlcarousel//29; type=int; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.autoplayTimeout
		ConautoplayTimeout = 5000
		# cat=plugin.tx_nsallsliders_owlcarousel//30; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.autoplayHoverPause
		ConautoplayHoverPause = 
		# cat=plugin.tx_nsallsliders_owlcarousel//31; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.autoplaySpeed
		ConautoplaySpeed = 3000
		# cat=plugin.tx_nsallsliders_owlcarousel//32; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.navSpeed
		ConnavSpeed = 3000
		# cat=plugin.tx_nsallsliders_owlcarousel//33; type=type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dotsSpeed
		CondotsSpeed = 1000
		# cat=plugin.tx_nsallsliders_owlcarousel//34; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dragEndSpeed
		CondragEndSpeed = 
		# cat=plugin.tx_nsallsliders_owlcarousel//35; type=options[bounce,shake,fadeOutLeft,flipOutX,rollOut,fadeOutUpBig,slideOutDown,slideOutUp,flipOutY,bounceOutUp,lightSpeedOut,rotateOutDownLeft]; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.animateOut
		ConanimateOut = slideOutDown
		# cat=plugin.tx_nsallsliders_owlcarousel//36; type=options[bounce,shake,fadeInLeft,flipInX,rollIn,fadeInUpBig,slideInDown,slideInUp,flipInY,bounceInUp,lightSpeedIn,rotateInDownLeft]; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.animateIn
		ConanimateIn = flipInX
		# cat=plugin.tx_nsallsliders_owlcarousel//37; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.fallbackEasing
		ConfallbackEasing = swing
		# cat=plugin.tx_nsallsliders_owlcarousel//38; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.info
		Coninfo =
		# cat=plugin.tx_nsallsliders_owlcarousel//39; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.nestedItemSelector
		ConnestedItemSelector =
		# cat=plugin.tx_nsallsliders_owlcarousel//40; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.itemElement
		ConitemElement = div
		# cat=plugin.tx_nsallsliders_owlcarousel//41; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.navContainer
		ConnavContainer =
		# cat=plugin.tx_nsallsliders_owlcarousel//42; type=string; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.dotsContainer
		CondotsContainer =
		# cat=plugin.tx_nsallsliders_owlcarousel//43; type=boolean; label=LLL:EXT:ns_all_sliders/Resources/Private/Language/locallang.xlf:flexform.checkVisible
		ConcheckVisible = 1
	}
}
